# Ignore local build artifacts
*.exe
*.spec
build*/
dist*/
__pycache__/
*.pyc

# Generated research reports and notebook exports
research/generated/

# Jupyter autosaves: duplicates of the notebook next to the notebook
.ipynb_checkpoints/

# Локальное виртуальное окружение Python (ранее ошибочно хранилось в репозитории)
venv/
.venv/

# Local Git recovery and session metadata
.git-recovery/
.openscience/session.txt

# Local rebuilt corpora contain machine-specific paths and derived snapshots
Colab Notebooks_rebuilt/
Colab Notebooks_rebuilt_snapshots/
Colab Notebooks_rebuilt_staging_*/

# Machine-local paths to external medical and physiological data
Colab Notebooks/config/*.local.json

# Local unsanitized provenance snapshots
Colab Notebooks/archive/private/

# Subject-linked historical derived data stay local; canonical artifacts use external derived_root
Colab Notebooks/timestamps/*.json
Colab Notebooks/params/*.json

# Full local scientific report contains individual CT/FEM geometry.
/Colab Notebooks/20.10_КТ_FEM_локализация_боковых_матриц_МГТУ.ipynb
/Colab Notebooks/20.10_КТ_FEM_локализация_боковых_матриц_МГТУ.html
