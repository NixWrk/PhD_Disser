output/**
!output/
!output/**/
!output/.gitkeep

# Keep authored code, notebooks, and HTML reports, including report history.
!output/**/*.html
!output/**/*.m
!output/**/*.py
!output/**/*.ipynb
!output/**/*.md
!output/**/*.ps1

# Vendored solver environments and generated caches are reproducible dependencies.
output/**/python_solver_deps/
output/**/site-packages/
output/**/.venv*/
output/**/venv/
output/**/__pycache__/
output/**/.ipynb_checkpoints/

# Real subject data are large and/or private. Keep local copies here,
# but commit only small examples and documentation.
data/*/stl/*.stl
data/*/stl/*.STL
data/*/signal/*.csv
data/*/signal/*.CSV
data/*/electrodes/*.csv
data/*/electrodes/*.CSV
data/*/electrodes/*.json
data/*/source_manifest.json

*.asv
*.m~

# Local CT placement scene and manual coordinates; rebuild from the source tool.
output/exploratory/georg_tepc_manual_*/

# Reconstructed subject anatomy, local solver runtime, and private verification files.
# Reader exports are kept separately in Colab Notebooks/scorpion_v2.
output/exploratory/georg_ct_model_*/
output/exploratory/georg_tepc_picker_*/
output/exploratory/georg_tepc_surface_audit_*/
output/exploratory/georg_lateral_inverse_*/
output/exploratory/georg_quality_rebuild_*/
output/exploratory/georg_model_audit_*/
