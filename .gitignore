# Ignore local build artifacts
*.exe
*.spec
build*/
dist*/
__pycache__/
*.pyc

# Generated research reports and notebook exports
research/generated/

# Jupyter autosaves: duplicates of the notebook next to the notebook
.ipynb_checkpoints/

# Локальное виртуальное окружение Python (ранее ошибочно хранилось в репозитории)
venv/
.venv/

# Local Git recovery and session metadata
.git-recovery/
.openscience/session.txt

# Local rebuilt corpora contain machine-specific paths and derived snapshots
Colab Notebooks_rebuilt/
Colab Notebooks_rebuilt_snapshots/
Colab Notebooks_rebuilt_staging_*/

# Machine-local paths to external medical and physiological data
Colab Notebooks/config/*.local.json

# Keep non-source private artifacts local, but retain authored code, notebooks,
# MATLAB scripts, and HTML research reports in Git.
Colab Notebooks/archive/private/**
!Colab Notebooks/archive/private/
!Colab Notebooks/archive/private/**/
!Colab Notebooks/archive/private/**/*.html
!Colab Notebooks/archive/private/**/*.m
!Colab Notebooks/archive/private/**/*.py
!Colab Notebooks/archive/private/**/*.ipynb
!Colab Notebooks/archive/private/**/*.md
Colab Notebooks/archive/private/**/__pycache__/
Colab Notebooks/archive/private/**/.ipynb_checkpoints/

# Subject-linked historical derived data stay local; canonical artifacts use external derived_root
Colab Notebooks/timestamps/*.json
Colab Notebooks/params/*.json
# Local notebook replay state and protected input manifests
Colab Notebooks/.notebook-runs/
Colab Notebooks/audits/**/*.local.json
Colab Notebooks/audits/**/*.local.txt
Colab Notebooks/audits/**/.protected-inputs.local.json

# Local HTML copies of subject-linked CT surfaces and landmark exports.
Colab Notebooks/results/ct_capsule_viewer.local/

# Machine-specific HnL bindings and Windows thumbnail caches are not source files.
HnL/config/*.local.json
Thumbs.db

# Primary experimental signals, photos and subject-linked processing stay local.
/Experiments/*/raw/
# Индивидуальные 3D-поверхности нового просмотра остаются локальными.
/Colab Notebooks/scorpion_v2/20.41_3D_боковая_установка_Ника_и_Ярослава_Scorpion.html
/Colab Notebooks/scorpion_v2/33.4*_3D_*.local.html
/Experiments/*/photos/
/Experiments/*/attachments/
/Experiments/*/metadata/
/Experiments/*/annotations/
/Experiments/*/derived/
/Experiments/**/*.local.*
# Original Scorpion v2 upload; retained unchanged alongside the extracted copy.
/Георг_05_10_26.zip

# Local report rendering caches and machine settings (sources and figures stay tracked).
/.claude/settings.local.json
/output/gph_concise_20261029/
/output/gph_report_20261029/
/Colab Notebooks/Отчёт_ГПХ_РНЦХ/report/revision_*/render/
# Original supplied photographs remain local; prepared report illustrations are retained.
/Colab Notebooks/Отчёт_ГПХ_РНЦХ/report/revision_20261029_author_review/figures/photos/
